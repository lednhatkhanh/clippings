# Copy to .env.local. Never commit real values.

# Neon pooled URL (the app). Migrations use DATABASE_URL_DIRECT instead:
#   DATABASE_URL_DIRECT=... pnpm --filter @clippings/db migrate
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clippings

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3100

# Google OAuth client. Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in: comma- or whitespace-separated emails. Empty means nobody.
ALLOWED_EMAILS=you@example.com

# Enrichment. QStash delivers each job to /api/jobs/enrich and signs it with these keys (Upstash
# console → QStash). QSTASH_URL is the endpoint to publish to: set it when the console lists one
# (a regional account), or to a local QStash server; leave it unset to use the default.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=http://127.0.0.1:8080

# Claude Haiku reads each page. ANTHROPIC_BASE_URL is only for pointing at a fake.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=http://127.0.0.1:8081

# Voyage AI embeds each page and each search query, for search by meaning. Without it, search
# matches words only. VOYAGE_BASE_URL is only for pointing at a fake.
VOYAGE_API_KEY=
# VOYAGE_BASE_URL=http://127.0.0.1:8082

# Vercel Cron sends this as a bearer token to /api/cron/sweep. Without it the sweep refuses.
CRON_SECRET=

# Non-production deployments are behind Vercel's deployment protection, which would block QStash.
# The project's "Protection Bypass for Automation" secret lets its calls through.
# VERCEL_AUTOMATION_BYPASS_SECRET=
