# The app's environment for trying a change locally: a throwaway Postgres container and the fakes
# in scripts/local/fakes.mjs. Dummy values only. Never put real secrets here.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/clippings_local
BETTER_AUTH_SECRET=local-secret-local-secret-local-secret
BETTER_AUTH_URL=http://localhost:3100
GOOGLE_CLIENT_ID=local
GOOGLE_CLIENT_SECRET=local
ALLOWED_EMAILS=local@example.com
QSTASH_TOKEN=local
QSTASH_URL=http://127.0.0.1:8080
QSTASH_CURRENT_SIGNING_KEY=local-current-key
QSTASH_NEXT_SIGNING_KEY=local-next-key
ANTHROPIC_API_KEY=local
ANTHROPIC_BASE_URL=http://127.0.0.1:8081
CRON_SECRET=local-cron
