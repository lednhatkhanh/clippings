{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "import/extensions": ["error", "always", { "ignorePackages": true }],
    "no-restricted-globals": [
      "error",
      {
        "name": "Date",
        "message": "Use date-fns (constructNow, parseISO, addDays, format) instead of the Date global."
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/set-state-in-render": "error",
    "react/set-state-in-effect": "error",
    "react/immutability": "error",
    "react/static-components": "error",
    "react/preserve-manual-memoization": "error",
    "react/use-memo": "error",
    "react/incompatible-library": "error",
    "react/globals": "error",
    "react/error-boundaries": "error",
    "react/unsupported-syntax": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "warn",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/web/**"],
      "rules": { "import/no-relative-parent-imports": "error" }
    }
  ],
  "ignorePatterns": [
    ".next",
    ".wxt",
    ".output",
    ".turbo",
    "node_modules",
    "packages/ui/src/generated"
  ],
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "ui": "@clippings/ui",
      "themeImports": ["^@clippings/ui/"]
    }
  }
}
