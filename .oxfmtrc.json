{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "sortImports": {
    "internalPattern": ["@clippings/", "@/"]
  },
  "sortTailwindcss": {
    "stylesheet": "./apps/web/app/globals.css",
    "functions": ["cn"]
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "playwright-report",
    "test-results",
    ".next",
    ".next-e2e",
    ".wxt",
    ".output",
    ".turbo",
    "node_modules",
    ".claude",
    "docs",
    "CLAUDE.md",
    "skills-lock.json",
    "packages/ui/src/generated"
  ]
}
