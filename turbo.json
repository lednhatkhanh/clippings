{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".oxlintrc.json",
    ".oxfmtrc.json",
    ".node-version",
    "scripts/*.mjs",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "typegen": {
      "outputs": [".next/types/**", "next-env.d.ts", ".wxt/**"]
    },
    "lint": {
      "dependsOn": ["typegen"]
    },
    "format:check": {},
    "typecheck": {
      "dependsOn": ["typegen"]
    },
    "test": {
      "env": ["TEST_DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "env": ["EXPOSE_TESTING_API"],
      "outputs": [".next/**", "!.next/cache/**", ".output/**"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["E2E_DATABASE_URL", "PLAYWRIGHT_*"],
      "passThroughEnv": ["CI"]
    }
  }
}
