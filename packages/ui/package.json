{
  "name": "@clippings/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.json": "./src/generated/tokens.json",
    "./tailwind.css": "./src/styles/tailwind.css"
  },
  "scripts": {
    "generate": "tsx scripts/generate-theme.ts",
    "check:generated": "tsx scripts/generate-theme.ts --check",
    "lint": "oxlint -c ../../.oxlintrc.json . && pnpm check:generated",
    "format:check": "oxfmt --check -c ../../.oxfmtrc.json .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clippings/shared": "workspace:*",
    "@material/material-color-utilities": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "react-aria-components": "catalog:"
  },
  "devDependencies": {
    "@clippings/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
