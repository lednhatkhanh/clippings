{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm check:root)",
      "Bash(pnpm turbo run *)",
      "Bash(pnpm --filter @clippings/ui generate)",
      "Bash(pnpm --filter @clippings/ui build:icons)",
      "Bash(pnpm --filter @clippings/ui check:generated)",
      "Bash(pnpm --filter @clippings/ui check:icons)",
      "Bash(node scripts/run-checks.mjs)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git branch --show-current)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(agent-browser *)",
      "Bash(curl * http://localhost:3100/_next/mcp*)",
      "mcp__next-devtools"
    ],
    "ask": [
      "Bash(pnpm --filter @clippings/db migrate*)",
      "Bash(vercel *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push *production*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(/packages/ui/src/generated/**)"
    ]
  },
  "enabledMcpjsonServers": ["next-devtools"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*.ts|\"$CLAUDE_PROJECT_DIR\"/*.tsx|\"$CLAUDE_PROJECT_DIR\"/*.js|\"$CLAUDE_PROJECT_DIR\"/*.mjs|\"$CLAUDE_PROJECT_DIR\"/*.json|\"$CLAUDE_PROJECT_DIR\"/*.css|\"$CLAUDE_PROJECT_DIR\"/*.yml) \"$CLAUDE_PROJECT_DIR/node_modules/.bin/oxfmt\" --write -c \"$CLAUDE_PROJECT_DIR/.oxfmtrc.json\" \"$f\";; esac; } >/dev/null 2>&1 || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
