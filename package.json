{
  "name": "clippings",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "turbo run lint",
    "format:check": "turbo run format:check",
    "check:root": "oxfmt --check package.json turbo.json pnpm-workspace.yaml .oxlintrc.json .oxfmtrc.json .github scripts && oxlint -c .oxlintrc.json scripts && pnpm --filter @clippings/ui check:icons",
    "format": "oxfmt --write apps packages scripts package.json turbo.json pnpm-workspace.yaml .oxlintrc.json .oxfmtrc.json .github",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@shadcn/lint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.11.2"
}
